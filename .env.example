# Copy to .env for local Docker Compose development and replace all placeholders.
# Docker Compose overrides DATABASE_URL, REDIS_URL, and service URLs with container-network values.

ACCESS_TOKEN_SECRET=replace-with-a-shared-access-secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=replace-with-a-refresh-secret
REFRESH_TOKEN_EXPIRY=10d

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/defect-loupe
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

RESEND_EMAIL_VERIFICATION_KEY=replace-with-resend-api-key
APP_BASE_URL=http://localhost:8000
PUBLIC_VERIFY_URL=http://localhost/api/v1/reports
EMAIL_FROM_ADDRESS=DefectLoupe <onboarding@resend.dev>

R2_ACCOUNT_ID=replace-with-r2-account-id
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
R2_BUCKET_NAME=defectloupe-media
R2_ENDPOINT_URL=https://replace-with-account-id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://replace-with-public-bucket-url

GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
EMBEDDING_MODEL=all-MiniLM-L6-v2
WHISPER_MODEL=small
