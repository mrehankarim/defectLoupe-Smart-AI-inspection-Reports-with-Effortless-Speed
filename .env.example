# =============================================================================
# DefectLoupe — Deployment Environment Configuration
# =============================================================================
# This file contains ALL environment variables needed to deploy DefectLoupe.
# Copy this file to .env and replace all placeholder values.
#
# Usage:
#   cp .env.deploy .env
#   # Edit all "replace-with-*" values
#   docker compose up --build -d
#
# IMPORTANT: docker-compose.yaml overrides DATABASE_URL, REDIS_URL, and
# service URLs with container-network values automatically. The values below
# are for local development or when running services outside Docker.
# =============================================================================

# -----------------------------------------------------------------------------
# JWT Authentication (MUST be identical across ALL services)
# -----------------------------------------------------------------------------
# Generate strong secrets: python -c "import secrets; print(secrets.token_hex(32))"
ACCESS_TOKEN_SECRET=replace-with-a-strong-64-char-hex-secret
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=replace-with-a-different-64-char-hex-secret
REFRESH_TOKEN_EXPIRY=10d

# -----------------------------------------------------------------------------
# Database (PostgreSQL 15 + pgvector)
# -----------------------------------------------------------------------------
# Docker Compose: postgresql://postgres:postgres@db:5432/defect-loupe
# Local dev:      postgresql://postgres:postgres@localhost:5433/defect-loupe
DATABASE_URL=postgresql://postgres:postgres@db:5432/defect-loupe

# PostgreSQL container credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=defect-loupe

# -----------------------------------------------------------------------------
# Redis (Message Broker + Cache)
# -----------------------------------------------------------------------------
# Docker Compose: redis://redis:6379/0
# Local dev:      redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# CORS & Cookie Security
# -----------------------------------------------------------------------------
# Comma-separated list of allowed origins (no trailing slash)
# Production example: https://app.defectloupe.com,https://dashboard.defectloupe.com
CORS_ORIGINS=http://localhost,http://localhost:5173,http://localhost:80
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# -----------------------------------------------------------------------------
# Email Verification (Resend API)
# -----------------------------------------------------------------------------
# Get your API key at: https://resend.com/api-keys
RESEND_EMAIL_VERIFICATION_KEY=replace-with-resend-api-key

# Set to "true" to skip email verification in dev/staging
DEV_AUTO_VERIFY=false

# Base URL for email verification links
APP_BASE_URL=http://localhost

# Sender address shown in verification emails
EMAIL_FROM_ADDRESS=DefectLoupe <onboarding@resend.dev>

# Public URL for report verification page (shown in QR codes)
PUBLIC_VERIFY_URL=http://localhost/api/v1/reports

# -----------------------------------------------------------------------------
# Cloud Storage — Cloudinary (Photos & Voice Notes)
# -----------------------------------------------------------------------------
# Get credentials at: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret
CLOUDINARY_URL=cloudinary://replace-with-api-key:replace-with-api-secret@replace-with-cloud-name

# Alternative: Cloudflare R2 (uncomment if using R2 instead of Cloudinary)
# R2_ACCOUNT_ID=replace-with-r2-account-id
# R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
# R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
# R2_BUCKET_NAME=defectloupe-media
# R2_ENDPOINT_URL=https://replace-with-account-id.r2.cloudflarestorage.com
# R2_PUBLIC_URL=https://replace-with-public-bucket-url

# -----------------------------------------------------------------------------
# AI — Google Gemini (Vision Analysis + Report Generation)
# -----------------------------------------------------------------------------
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# AI — Embeddings (runs locally, no API key needed)
# -----------------------------------------------------------------------------
# HuggingFace model for RAG vector embeddings (384-dimensional)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# -----------------------------------------------------------------------------
# AI — Speech-to-Text (Whisper)
# -----------------------------------------------------------------------------
# Model size: tiny, base, small, medium, large-v3
# "small" is a good balance of speed vs accuracy
WHISPER_MODEL=small

# -----------------------------------------------------------------------------
# Inter-Service Communication (Docker internal DNS)
# -----------------------------------------------------------------------------
# These are overridden by docker-compose.yaml — only needed for local dev
CORE_SERVICE_URL=http://core:8000
MEDIA_SERVICE_URL=http://media:8000

# -----------------------------------------------------------------------------
# File Upload Storage Path (Media Service)
# -----------------------------------------------------------------------------
# Docker Compose overrides this to /data/uploads (backed by named volume)
UPLOAD_DIR=/data/uploads
