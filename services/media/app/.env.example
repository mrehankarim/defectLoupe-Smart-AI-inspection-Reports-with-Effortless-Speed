# media-service environment template.
# Copy to services/media/app/.env and fill in real values.

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/defect-loupe
REDIS_URL=redis://localhost:6379/0

# JWT secret (same across ALL services)
ACCESS_TOKEN_SECRET=your_shared_secret
ACCESS_TOKEN_EXPIRY=15m

# Cloudinary (image & video storage / CDN)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# Whisper STT model size: tiny, base, small, medium, large-v3
WHISPER_MODEL=small
