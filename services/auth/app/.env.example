# Copy this file to app/.env and fill in real values:
#   cp app/.env.example app/.env

# PostgreSQL connection string
#   Docker Compose backend container: postgresql://postgres:postgres@db:5432/defect-loupe
#   Local Python dev (DB in Docker): postgresql://postgres:postgres@localhost:5433/defect-loupe
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/defect-loupe

# JWT token secrets and lifespans
ACCESS_TOKEN_SECRET=your_secret_string
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_SECRET=your_secret_string
REFRESH_TOKEN_EXPIRY=10d

# Resend API key for email verification (https://resend.com/api-keys)
RESEND_EMAIL_VERIFICATION_KEY=re_your_resend_api_key

# App base URL used in verification links and the sender address shown in emails
APP_BASE_URL=http://localhost:8000
EMAIL_FROM_ADDRESS=DefectLoupe <onboarding@resend.dev>
