# core-service environment template.
# Copy to services/core/app/.env and fill in real values.
#
# When running via docker-compose, DATABASE_URL is overridden
# in docker-compose.yaml to point at the internal db container.

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/defect-loupe

# JWT secret (must match auth-service so local JWT decode works)
ACCESS_TOKEN_SECRET=your_shared_secret
ACCESS_TOKEN_EXPIRY=15m

# CORS allowed origins (comma-separated, for web frontend)
# Example: http://localhost:5173,http://localhost:3000
CORS_ORIGINS=*
