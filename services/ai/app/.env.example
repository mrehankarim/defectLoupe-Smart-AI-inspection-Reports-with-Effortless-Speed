# ai-service environment template.
# Copy to services/ai/app/.env and fill in real values.

DATABASE_URL=postgresql://postgres:postgres@localhost:5433/defect-loupe
REDIS_URL=redis://localhost:6379/0

# JWT secret (same across ALL services)
ACCESS_TOKEN_SECRET=your_shared_secret
ACCESS_TOKEN_EXPIRY=15m

# Cross-service URLs (Docker internal DNS in prod; localhost in dev)
CORE_SERVICE_URL=http://localhost:8002
MEDIA_SERVICE_URL=http://localhost:8003

# Google Gemini (free tier) — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-1.5-flash

# Embeddings (runs locally, no API key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Groq (fast LLM for RAG text synthesis) — https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# App URLs (used in QR codes / report headers)
APP_BASE_URL=http://localhost:8000
PUBLIC_VERIFY_URL=http://localhost/api/v1/reports
